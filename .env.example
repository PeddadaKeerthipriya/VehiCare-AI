# Copy to .env (same directory as docker-compose.yml) and fill in real
# values. These are used at FRONTEND BUILD TIME — docker-compose reads
# them and passes them into Dockerfile.frontend as build args. Never
# commit the real .env file.

NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
