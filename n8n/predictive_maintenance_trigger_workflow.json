    {
      "parameters": {
        "jsCode": "const getItems = (nodeName) => {\n  try {\n    const raw = $(nodeName).all();\n    if (Array.isArray(raw)) return raw.map(i => i.json);\n  } catch (e) {}\n  try {\n    const raw = $items(nodeName);\n    if (Array.isArray(raw)) return raw.map(i => i.json);\n    if (raw && raw.json) return Array.isArray(raw.json) ? raw.json : [raw.json];\n  } catch (e) {}\n  try {\n    const nodeObj = $node[nodeName];\n    if (nodeObj && nodeObj.json) {\n      return Array.isArray(nodeObj.json) ? nodeObj.json : [nodeObj.json];\n    }\n  } catch (e) {}\n  return [];\n};\n\nconst vehicleRows = getItems('Fetch Vehicle Odometer');\nconst vehicle = vehicleRows.length > 0 ? vehicleRows[0] : {};\nconst vehicleId = vehicle.id || 'ce149694-3228-4951-897a-5be5ed52f55c';\nconst currentOdometer = parseInt(vehicle.odometer_km || 0);\n\nconst parseDate = (dateVal) => {\n  if (!dateVal) return null;\n  try {\n    return new Date(dateVal);\n  } catch (e) {\n    return null;\n  }\n};\n\nconst addMonths = (sourceDate, months) => {\n  const d = new Date(sourceDate);\n  d.setMonth(d.getMonth() + months);\n  return d;\n};\n\nconst OEM_INTERVALS = {\n  oil: { km: 10000, months: 12, name: 'Engine Oil Replacement' },\n  tyre: { km: 10000, months: 6, name: 'Tyre Rotation / Replacement' },\n  brake: { km: 30000, months: 36, name: 'Brake System Inspection & Pads' },\n  battery: { km: 40000, months: 48, name: 'Battery Health & Replacement' },\n  air_filter: { km: 20000, months: 24, name: 'Engine Air Filter Replacement' }\n};\n\nconst today = new Date();\nconst scheduleItems = [];\n\nfor (const [compKey, cfg] of Object.entries(OEM_INTERVALS)) {\n  const dueOdometer = currentOdometer + cfg.km;\n  const dueDate = addMonths(today, cfg.months);\n  \n  scheduleItems.push({\n    vehicle_id: vehicleId,\n    task_name: cfg.name,\n    due_date: dueDate.toISOString().split('T')[0],\n    due_odometer_km: dueOdometer,\n    status: 'pending'\n  });\n}\n\nreturn [{\n  json: {\n    vehicle_id: vehicleId,\n    batch: scheduleItems\n  }\n}];"
      },
